    <string name="beta_sheet_avoid_title">Vui lòng tránh</string>
    <string name="beta_sheet_avoid_1">Các báo cáo chung chung như \"Nó không hoạt động\".</string>
    <string name="beta_sheet_avoid_2">Nhiều vấn đề không liên quan trong một vấn đề.</string>
    <string name="beta_sheet_avoid_3">Nhật ký hoặc ảnh chụp màn hình chưa chỉnh sửa với dữ liệu riêng tư.</string>
    <string name="beta_sheet_privacy_title">Lưu ý quyền riêng tư</string>
    <string name="beta_sheet_privacy_body">Trước khi đăng nhật ký, ảnh chụp màn hình hoặc video, hãy xóa thông tin cá nhân hoặc riêng tư.</string>
    <string name="beta_sheet_nightly_title">Các bản nightly</string>
    <string name="beta_sheet_nightly_summary">Các bản nightly khác với bản phát hành như thế nào, và cần bao gồm gì khi chúng gặp sự cố.</string>
    <string name="beta_sheet_nightly_body">Các bản nightly được tạo từ commit mới nhất và có thể chứa các thay đổi chưa hoàn thành, lỗi tạm thời hoặc sự suy giảm. Chúng mang tính thử nghiệm hơn các bản phát hành chính thức.</string>
    <string name="beta_sheet_nightly_access">Truy cập chúng từ các artifact của quy trình GitHub Actions trong kho lưu trữ nếu có.</string>
    <string name="beta_sheet_nightly_report_title">Báo cáo vấn đề nightly</string>
    <string name="beta_sheet_nightly_report_body">Khi báo cáo vấn đề từ bản nightly, luôn đề cập rằng nó xảy ra trên bản nightly, không phải trên bản phát hành chính thức. Bao gồm ngày build, tên hoặc số quy trình chạy, hoặc commit SHA nếu có thể. Cũng kiểm tra xem vấn đề tương tự có xảy ra trên bản phát hành chính thức mới nhất không.</string>
    <string name="beta05_title">Nâng cấp Beta 0.5.0</string>
    <string name="beta05_clean_install_title">Khuyến nghị cài đặt sạch</string>
    <string name="beta05_clean_install_body">Nếu bạn đến từ beta 0.5.0, bản cập nhật này có thể cần dữ liệu thư viện mới thay vì trạng thái cache cũ.</string>
    <string name="beta05_if_wrong_meta_title">Nếu metadata hoặc mục thư viện hiển thị sai</string>
    <string name="beta05_if_wrong_meta_body">Metadata bài hát sai, nghệ sĩ hoặc album không khớp, hoặc các mục bị trùng lặp thường có nghĩa là cài đặt sạch là giải pháp.</string>
