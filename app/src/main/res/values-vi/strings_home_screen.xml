    <string name="beta_sheet_version">Beta 0.7.5</string>
    <string name="beta_sheet_letter">β</string>
    <string name="beta_sheet_welcome_title">Chào mừng đến với PixelPlayer 0.7.5-beta</string>
    <string name="beta_sheet_welcome_body">Bạn đang sử dụng bản beta có thể chứa lỗi, sự cố hoặc các tính năng thử nghiệm. Hãy giúp chúng tôi cải thiện bằng cách báo cáo vấn đề.</string>
    <string name="beta_sheet_expect_title">Những gì cần mong đợi</string>
    <string name="beta_sheet_expect_1">Lỗi, sự cố hoặc các tính năng chưa hoàn thiện có thể xảy ra bất ngờ.</string>
    <string name="beta_sheet_expect_2">Một số tính năng có thể thay đổi hoặc bị xóa mà không thông báo.</string>
    <string name="beta_sheet_expect_3">Các bản beta có thể không ổn định hơn bản phát hành chính thức.</string>
    <string name="beta_sheet_expect_4">Luôn kiểm tra bản cập nhật trước khi báo cáo vấn đề đã biết.</string>
    <string name="beta_sheet_expect_summary">Những gì bản beta có thể thay đổi, gây lỗi hoặc cải thiện trong quá trình thử nghiệm.</string>
    <string name="beta_sheet_github_title">Shortcut vấn đề GitHub</string>
    <string name="beta_sheet_github_body">Tìm kiếm trước, sau đó mở báo cáo tập trung cho lỗi, sự cố, yêu cầu hoặc câu hỏi.</string>
    <string name="beta_sheet_open_issues">Mở các vấn đề hiện có</string>
    <string name="beta_sheet_report_bug">Báo cáo vấn đề hoặc sự cố</string>
    <string name="beta_sheet_report_body">Chia sẻ các bước tái tạo, kết quả mong đợi, kết quả thực tế và thông tin thiết bị/hệ điều hành của bạn.</string>
    <string name="beta_sheet_report_title">Cách báo cáo</string>
